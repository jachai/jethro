{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/ae\" --data \"${CLAUDE_PLUGIN_DATA}\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/ae\" --data \"${CLAUDE_PLUGIN_DATA}\" hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
