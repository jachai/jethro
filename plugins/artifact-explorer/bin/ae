#!/bin/sh
# Runs scripts/ae.py with the first Python 3.9+ found (python3, python, py -3).
here=$(cd "$(dirname "$0")/.." && pwd)
for py in python3 python "py -3"; do
  if $py -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then
    exec $py "$here/scripts/ae.py" "$@"
  fi
done
echo "artifact-explorer: Python 3.9 or newer is required" >&2
exit 0
